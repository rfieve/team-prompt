{
    "name": "@romainfieve/team-prompt",
    "version": "0.11.0",
    "description": "A TypeScript tool to create prompt based on team members.",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "docs": "typedoc src/index.ts",
        "build": "tsup",
        "lint": "eslint --fix ./src/ --ext .js --ext .ts --ext .tsx --format table",
        "test": "NODE_PATH=./ jest --coverage --passWithNoTests",
        "test:watch": "NODE_PATH=./ jest --watch --coverage --passWithNoTests",
        "prepublishOnly": "tsup"
    },
    "author": "rfieve",
    "license": "MIT",
    "keywords": [
        "typescript",
        "team-prompt",
        "utility"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rfieve/team-prompt.git"
    },
    "homepage": "https://github.com/rfieve/team-prompt#readme",
    "bugs": {
        "url": "https://github.com/rfieve/team-prompt/issues"
    },
    "devDependencies": {
        "@jest/types": "30.5.1",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.5",
        "@typescript-eslint/eslint-plugin": "8.71.1",
        "@typescript-eslint/parser": "8.71.1",
        "eslint": "10.12.0",
        "eslint-formatter-table": "7.32.1",
        "eslint-plugin-align-assignments": "1.1.2",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-typescript-sort-keys": "3.3.0",
        "eslint-plugin-unicorn": "77.0.0",
        "jest": "30.5.2",
        "prettier": "3.9.10",
        "ts-jest": "29.4.14",
        "ts-node": "10.9.1",
        "tsup": "8.5.1",
        "typedoc": "0.28.20",
        "typescript": "6.0.3"
    },
    "resolutions": {
        "**/@typescript-eslint/typescript-estree/minimatch": "9.0.7",
        "tsup/esbuild": "0.28.1"
    }
}
